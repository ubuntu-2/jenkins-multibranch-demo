pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo "Running Build stage on branch: ${env.BRANCH_NAME}"
            }
        }
        stage('Test') {
            steps {
                echo "Running Test stage..."
                // פקודה המדמה כישלון בשלב ה-Test לבדיקת ה-Stage View בג'נקינס
                sh 'exit 1'
            }
        }
    }
}
